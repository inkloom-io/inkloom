{
  "name": "@inkloom/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "data:dev": "wrangler dev --config wrangler.jsonc",
    "data:deploy": "wrangler deploy --config wrangler.jsonc",
    "data:migrate:local": "wrangler d1 migrations apply inkloom-local --local --config wrangler.jsonc",
    "data:migrate:remote": "wrangler d1 migrations apply inkloom-local --remote --config wrangler.jsonc",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "build": "echo 'core/apps/web is built via apps/dev — skipping standalone build'",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@blocknote/core": "^0.46.2",
    "@blocknote/mantine": "^0.46.2",
    "@blocknote/react": "^0.46.2",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/zod-validator": "0.7.6",
    "@inkloom/docs-renderer": "workspace:*",
    "@inkloom/mdx-parser": "workspace:*",
    "@inkloom/ui": "workspace:*",
    "@mantine/core": "^8.3.11",
    "@mantine/hooks": "^8.3.11",
    "@tanstack/query-core": "^5.90.0",
    "@tanstack/react-query": "^5.45.0",
    "create-inkloom": "workspace:*",
    "drizzle-orm": "0.45.2",
    "elkjs": "^0.9.3",
    "hono": "4.12.32",
    "katex": "^0.16.38",
    "linkifyjs": "^4.3.0",
    "lucide-react": "^0.563.0",
    "mermaid": "^11.4.0",
    "next": "^16.1.6",
    "next-intl": "^4.8.3",
    "next-themes": "^0.4.6",
    "openapi-types": "^12.1.3",
    "react": "^19.0.0",
    "react-arborist": "^3.4.3",
    "react-dom": "^19.0.0",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "shiki": "^3.22.0",
    "unified": "^11.0.5",
    "yaml": "^2.8.2",
    "yjs": "^13.6.29",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260727.1",
    "@inkloom/eslint-config": "workspace:*",
    "@inkloom/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/katex": "^0.16.8",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "0.31.10",
    "eslint": "^8.57.0",
    "minisearch": "^7.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5",
    "vitest": "^4.0.18",
    "wrangler": "4.114.0"
