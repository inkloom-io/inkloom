{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inkloom-data",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inkloom-local",
      "database_id": "local",
      "migrations_dir": "db/migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
